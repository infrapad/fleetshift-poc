# Copy to .env. Used by:
#   deploy/podman — AIO image (sqlite; peer Dex unless OIDC_ISSUER_URL is set)
#   deploy/kubernetes / deploy/keycloak — cluster deploy (different OIDC env names)

# ── Container Registry ──────────────────────────────────────────────
# Used by 'task image:build', 'task image:aio', and 'task image:push'.
# DEV_REGISTRY=quay.io/your-quay-username
IMAGE_TAG=latest

# ── FleetShift Server ──────────────────────────────────────────────
FLEETSHIFT_SERVER_HTTP_PORT=8085
FLEETSHIFT_SERVER_GRPC_PORT=50051
FLEETSHIFT_LOG_LEVEL=info

# AIO image override (compose default: quay.io/stolostron/fleetshift:latest).
# FLEETSHIFT_SERVER_IMAGE=quay.io/<user>/fleetshift:latest

# ── OIDC ────────────────────────────────────────────────────────────
# Unset OIDC_ISSUER_URL → peer Dex (demo users unless OpenShift mode below).
# Demo: ops@fleetshift.local / fleetshift-ops, dev@fleetshift.local / fleetshift-dev.
# Set OIDC_ISSUER_URL → external issuer; peer Dex parks.
# Register https://fleetshift-sandbox.localhost:8085, /app/auth/callback,
# and /app/silent-renew.html on an external IdP.
# OIDC_ISSUER_URL=https://your-keycloak.example.com/realms/fleetshift
# Opt-in local OpenShift login through peer Dex (bootstrap on host first; see deploy/podman/README.md):
# OPENSHIFT_DEX_MODE=openshift
# OPENSHIFT_DEX_HOST_DIR=/absolute/path/to/deploy/aio/.local/openshift-dex
# Do not set OIDC_ISSUER_URL at the same time. No OAuth secret belongs in .env.
# OIDC_UI_CLIENT_ID=fleetshift-ui
# OIDC_RESOURCE_AUDIENCE=fleetshift
# OIDC_KEY_ENROLLMENT_AUDIENCE=fleetshift-signing
# OIDC_CA_FILE=/path/in/container/ca.crt
#
# Leave OIDC_UI_SCOPE unset. Packaging picks Dex-on vs Dex-off from issuer.
# Optional public browser config (never credentials; /api/ui/config is unauthenticated).
# Use single quotes in .env to preserve JSON's double quotes.
# EXTERNAL_UI_CONFIG='{"infrapad":{"origin":"https://infrapad.example"}}'

# ── GCP HCP addon (optional) ────────────────────────────────────────
# Set GCPHCP_GATEWAY_URL to enable. Do not commit a concrete CLS gateway URL.
# GCPHCP_GATEWAY_URL=https://your-cls-gateway

# ── OCP Cluster URLs (task preconditions) ───────────────────────────
# oc whoami --show-server. KC_CLUSTER_API: kc:* and minio-nx-cache.
# OME_CLUSTER_API: k8s:*.
KC_CLUSTER_API=https://api.keycloak-cluster.example.com:6443
OME_CLUSTER_API=https://api.ome-cluster.example.com:6443

# ── Kubernetes deploy (task k8s:*) ──────────────────────────────────
# GCPHCP_ENABLED=true
# OIDC_AUDIENCE=fleetshift
# KEY_REGISTRY_ID=github.com
# KEY_REGISTRY_SUBJECT_EXPR=claims.github_username
# PUBLIC_KEY_CLAIM_EXPR=claims.signing_public_key
POSTGRES_USER=fleetshift
POSTGRES_PASSWORD=changeme
POSTGRES_DB=fleetshift

# ── Nx remote cache (optional) ──────────────────────────────────────
# NX_SELF_HOSTED_REMOTE_CACHE_SERVER=http://localhost:8420
# NX_SELF_HOSTED_REMOTE_CACHE_ACCESS_TOKEN=your-write-or-read-token
